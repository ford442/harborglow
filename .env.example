# Signalling worker URL for WebRTC multiplayer (?multiplayer=1)
VITE_SIGNAL_URL=http://localhost:8787

# Optional TURN relay (docs/adr/0003-turn-relay-via-env.md). Leave empty for
# STUN-only. Put real values in .env.local or the deploy shell — never commit.
# VITE_* values ship in the bundle: use short-lived / relay-scoped credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
