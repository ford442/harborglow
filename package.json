{
    "name": "harborglow",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run build:wasm && npm run check:wasm && npm run models:verify && tsc && vite build && npm run check:bundle",
        "build:analyze": "npm run build:wasm && npm run check:wasm && tsc && vite build --mode analyze",
        "build:wasm": "cd cpp && ./build.sh",
        "check:wasm": "node scripts/check-wasm.mjs",
        "check:bundle": "node scripts/check-bundle-size.mjs",
        "typecheck": "tsc --noEmit",
        "typecheck:tests": "tsc --noEmit -p tsconfig.vitest.json",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "vitest run",
        "smoke:dev-transform": "node scripts/smoke-dev-transform.mjs",
        "test:dev-transform": "npm run smoke:dev-transform",
        "test:e2e": "playwright test",
        "test:e2e:update": "playwright test --update-snapshots",
        "test:e2e:install": "playwright install chromium --with-deps",
        "generate:ship-glb": "node scripts/generate-ship-glb.mjs",
        "models:author": "node scripts/author-hero-glb.mjs",
        "models:verify": "node scripts/verify-ship-glb.mjs",
        "models:compress": "./scripts/compress-ship-glb.sh",
        "models:inspect": "npx --yes @gltf-transform/cli inspect",
        "models:optimize": "npx --yes @gltf-transform/cli optimize",
        "heartbeat": "echo '=== HEARTBEAT ===' && git status --porcelain && grep -r 'TODO\\|FIXME' src/ --include='*.ts' --include='*.tsx' || true && npm run build && npm test",
        "preview": "vite preview"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "@react-three/postprocessing": "^3.0.5",
        "@react-three/rapier": "^2.2.0",
        "@types/three": "0.183.1",
        "leva": "^0.10.1",
        "postprocessing": "6.39.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "three": "0.183.1",
        "three-stdlib": "^2.36.1",
        "zustand": "^4.4.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/node": "^20.19.43",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@webgpu/types": "^0.1.72",
        "autoprefixer": "^10.4.27",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.5.6",
        "rollup-plugin-visualizer": "^5.12.0",
        "tailwindcss": "^3.4.19",
        "terser": "^5.46.1",
        "tone": "^14.7.77",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^5.0.8",
        "vitest": "^4.1.5"
    }
}
