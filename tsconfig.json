{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "types": ["@webgpu/types"] // TODO(ts6) remove when DOM lib includes WebGPU
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/**/__tests__"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
